{
  "manifest_version": 3,
  "name": "Lumen Pod",
  "version": "0.1.0",
  "description": "View AI-powered podcast & video summaries alongside YouTube videos",

  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "scripting",
    "webNavigation"
  ],

  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*"
  ],

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "src/side-panel/index.html"
  },

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Lumen Pod",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["assets/*", "src/*"],
      "matches": ["*://www.youtube.com/*"]
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
