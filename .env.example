# Database
DATABASE_URL=postgres://lumenpod:lumenpod@127.0.0.1:5488/lumenpod
DB_PASSWORD=lumenpod

# API Server
PORT=3210
API_PORT=3210

# Google OAuth (get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3210/auth/google/callback

# Auth
JWT_SECRET=change-me-in-production
ALLOW_ALL_USERS=true   # Set to false in production to enforce whitelist

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Web Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3210
